<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode counterpart to values-v31/styles.xml — see there for why
         this exists. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">#0C1210</item>
        <item name="android:windowSplashScreenBackground">#0C1210</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:colorBackground">#0C1210</item>
    </style>
</resources>
